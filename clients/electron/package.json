{
  "name": "huawei-ibmc-kvm-client",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform Huawei iBMC KVM console client (no Java, no backend)",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/replay.test.js && node test/decoder.test.mjs",
    "test:replay": "node test/replay.test.js",
    "test:decoder": "node test/decoder.test.mjs",
    "test:store": "electron test/store.test.js",
    "test:gui": "electron . --selftest",
    "test:chromium": "electron . --replaytest ../huawei-ibmc-kvm-protocol/evidence/frame-2.bin 800 600 6",
    "test:all": "npm test && npm run test:store && npm run test:gui && npm run test:chromium",
    "gen-tables": "python3 tools/gen-jpeg-tables.py src/renderer/jpeg-tables.js"
  },
  "devDependencies": {
    "electron": "^44.4.2",
    "jpeg-js": "^0.4.4"
  }
}
